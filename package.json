{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "nest-cli": "11.0.24",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "dev:messaging-admin": "nest start messaging-admin --tsc --watch --debug 9267",
    "dev:worker": "nest start worker --tsc --watch --debug 9228",
    "dev:api": "nest start messaging-api --watch --tsc --debug 9229",
    "dev:cron": "nest start cron --watch --debug 9229",
    "dev:messaging-api": "nest start messaging-api --watch --debug 9230",
    "build:messaging-admin": "nest build messaging-admin",
    "build:worker": "nest build worker",
    "build:api": "nest build api",
    "start:messaging-admin": "node dist/apps/messaging-admin/main",
    "start:worker": "node dist/apps/worker/main",
    "start:api": "node dist/apps/api/main",
    "start:cron": "node dist/apps/cron/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api/test/jest-e2e.json",
    "generate:clickhouse-types": "hypequery generate -o \"libs/application/src/integrations/cpms-pcr-reader/schemas/database.schema.ts\" --tables PCR,BONUS_PCR,dynamicJackpotRecord"
  },
  "dependencies": {
    "@clickhouse/client": "^1.18.2",
    "@clickhouse/client-common": "^1.23.0",
    "@hypequery/clickhouse": "^2.5.4",
    "@nestjs/common": "11.0.1",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.0.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-jaeger": "^2.7.1",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.218.0",
    "@opentelemetry/instrumentation-ioredis": "^0.66.0",
    "@opentelemetry/instrumentation-mongoose": "^0.64.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.64.0",
    "@opentelemetry/propagator-b3": "^2.7.1",
    "@opentelemetry/propagator-jaeger": "^2.7.1",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@scalar/nestjs-api-reference": "^1.2.13",
    "@semyonf/smpp": "1.6.0",
    "@snsoft/nestjs-otel": "^0.0.13",
    "@snsoft/otel-trace": "^2.2.2",
    "axios": "^1.20.0",
    "chance": "^1.1.13",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "maskdata": "^1.3.4",
    "mongoose": "^9.9.1",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.5.0",
    "node-vault": "^0.12.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "pulsar-client": "1.15.0",
    "radash": "^12.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "save-dev": "0.0.1-security",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@hypequery/cli": "^1.16.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@scalar/types": "^0.17.1",
    "@types/chance": "^1.1.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^application/application(|/.*)$": "<rootDir>/libs/application/src/$1",
      "^framework/framework(|/.*)$": "<rootDir>/libs/framework/src/$1"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "pulsar-client"
    ],
    "ignoredBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf",
      "protobufjs"
    ]
  }
}
