{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": [
      "vitest/globals",
      "node"
    ],
    "paths": {
      "@application": [
        "./libs/application/src/index.ts"
      ],
      "@application/*": [
        "./libs/application/src/*"
      ],
      "@framework/*": [
        "./libs/framework/src/*"
      ],
      "@package": [
        "./package.json"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/messaging-api/tsconfig.app.json"
    },
    {
      "path": "./apps/backoffice-api/tsconfig.app.json"
    },
    {
      "path": "./libs/application/tsconfig.lib.json"
    },
    {
      "path": "./libs/framework/tsconfig.lib.json"
    },
    {
      "path": "./apps/cli/tsconfig.app.json"
    },
    {
      "path": "./apps/cron/tsconfig.app.json"
    },
    {
      "path": "./apps/log-consumer/tsconfig.app.json"
    },
    {
      "path": "./apps/viber-consumer-promotexter/tsconfig.app.json"
    }
  ]
}