{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@application": [
        "libs/application/src"
      ],
      "@application/*": [
        "libs/application/src/*"
      ],
      "@framework": [
        "libs/framework/src"
      ],
      "@framework/*": [
        "libs/framework/src/*"
      ],
      "@integrations": [
        "libs/application/src/integrations"
      ],
      "@integrations/*": [
        "libs/application/src/integrations/*"
      ],
      "@package": [
        "./package.json"
      ]
    }
  }
}